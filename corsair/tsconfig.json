{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "endpoints/**/*.ts",
    "schema/**/*.ts"
  ],
  "exclude": [
    "*.test.ts",
    "node_modules",
    "dist"
  ]
}
